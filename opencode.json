{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "deny",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "edit": {
      "*": "allow",
      ".git/**": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "opencode.json": "deny"
    },
    "external_directory": "deny",
    "bash": {
      "*": "deny",
      "pnpm *": "allow",
      "npx tsc*": "allow",
      "npx eslint*": "allow",
      "npx vitest*": "allow",
      "npx prettier*": "allow",
      "node *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git restore *": "allow",
      "git mv *": "allow",
      "ls*": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "mkdir *": "allow",
      "touch *": "allow",
      "mv *": "allow",
      "cp *": "allow",
      "rm *": "allow",
      "echo *": "allow",
      "pwd": "allow",
      "which *": "allow",
      "rm -r*": "deny",
      "rm -f*": "deny",
      "rm -rf*": "deny",
      "pnpm publish*": "deny",
      "pnpm dlx*": "deny",
      "npm publish*": "deny",
      "git push*": "deny",
      "git remote*": "deny",
      "git config*": "deny",
      "git reset --hard*": "deny",
      "curl*": "deny",
      "wget*": "deny",
      "sudo*": "deny",
      "* .env*": "deny"
    }
  }
}
