{
  "name": "parley-builder",
  "description": "Builds Parley MCP milestones from docs/PLAN.md under a scoped allowlist (unattended runs).",
  "prompt": "You build Parley MCP. Follow AGENTS.md exactly, including the section 'Workbench in OpenCode runs', which also applies to you. Your shell permissions are an allowlist; if a command is denied, find an allowed way or write the blocker in docs/PROGRESS.md. Never push or publish.",
  "tools": [
    "read",
    "write",
    "shell",
    "web"
  ],
  "resources": [
    "file://AGENTS.md",
    "file://docs/PLAN.md"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "effect": "deny",
        "match": [
          "**/.env",
          "**/.env.*",
          "**/*.pem",
          "**/*.key"
        ]
      },
      {
        "capability": "fs_write",
        "effect": "allow",
        "match": [
          "src/**",
          "test/**",
          "docs/**",
          ".workbench/**",
          "package.json",
          "pnpm-lock.yaml",
          "pnpm-workspace.yaml",
          "tsconfig.json",
          "eslint.config.js",
          "prettier.config.js",
          "vitest.config.ts"
        ]
      },
      {
        "capability": "fs_write",
        "effect": "deny",
        "match": [
          "opencode.json",
          ".kiro/**",
          ".githooks/**",
          ".github/**",
          "**/.env",
          "**/.env.*",
          ".workbench/config.json",
          ".workbench/rules.md"
        ]
      },
      {
        "capability": "shell",
        "effect": "allow",
        "match": [
          "pnpm *",
          "npx tsc*",
          "npx eslint*",
          "npx vitest*",
          "npx prettier*",
          "node *",
          "git status*",
          "git diff*",
          "git log*",
          "git show*",
          "git add *",
          "git commit *",
          "git restore *",
          "git mv *",
          "ls*",
          "cat *",
          "head *",
          "tail *",
          "wc *",
          "grep *",
          "find *",
          "mkdir *",
          "touch *",
          "mv *",
          "cp *",
          "rm *",
          "echo *",
          "pwd",
          "which *",
          "python3 /Users/inanccan/.claude/workbench/bin/wb.py *",
          "codex --version",
          "codex --help",
          "codex * --help",
          "codex app-server generate-json-schema*",
          "codex app-server generate-ts*"
        ]
      },
      {
        "capability": "shell",
        "effect": "deny",
        "match": [
          "rm -r*",
          "rm -f*",
          "git push*",
          "git remote*",
          "git config*",
          "git reset --hard*",
          "pnpm publish*",
          "pnpm dlx*",
          "npm publish*",
          "curl*",
          "wget*",
          "sudo*"
        ]
      },
      {
        "capability": "web_fetch",
        "effect": "allow"
      },
      {
        "capability": "web_search",
        "effect": "allow"
      }
    ]
  }
}
