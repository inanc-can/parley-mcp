{
  "name": "mcp-parley",
  "version": "0.1.0",
  "description": "Let coding agents find each other, message each other, and settle agreements on one machine.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "codex",
    "cursor",
    "grok",
    "coding-agents",
    "multi-agent",
    "agent-communication"
  ],
  "homepage": "https://github.com/inanc-can/parley-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inanc-can/parley-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/inanc-can/parley-mcp/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "mcp-parley": "dist/cli/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/viewer/static",
    "test": "vitest run",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/build-viewer.mjs",
    "prepublishOnly": "pnpm check && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.19.15",
    "esbuild": "0.28.2",
    "eslint": "^9.39.4",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "smol-toml": "1.4.2",
    "zod": "^4.6.7"
  }
}
